#include <stdio.h>
#include <stdlib.h>

void assert(int expected, int actual, char *code, int line) {
  if (expected == actual) {
    printf("%s => %d\n", code, actual);
  } else {
    printf("%s => %d expected but got %d in %d\n", code, expected, actual, line);
    exit(1);
  }
}

