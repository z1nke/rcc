#ifndef STMT
#define STMT(KIND)
#endif

#ifndef EXPR
#define EXPR(KIND) STMT(KIND)
#endif

#ifndef STMT_RANGE
#define STMT_RANGE(BASE, FIRST, LAST)
#endif

STMT(DeclStmt)
STMT(ReturnStmt)
STMT(CompoundStmt)
STMT(NullStmt)
STMT(IfStmt)
STMT(ForStmt)
STMT(WhileStmt)
STMT(BreakStmt)
STMT(ContinueStmt)
STMT(GotoStmt)
STMT(LabelStmt)

EXPR(UnaryOperator)
EXPR(UnaryExprOrTypeTraitExpr)
EXPR(BinaryOperator)
EXPR(IntegerLiteral)
EXPR(CharacterLiteral)
EXPR(StringLiteral)
EXPR(ParenExpr)
EXPR(DeclRefExpr)
EXPR(ArraySubscriptExpr)
EXPR(CallExpr)
EXPR(MemberExpr)
EXPR(CastExpr)
EXPR(StmtExpr)

STMT_RANGE(Expr, UnaryOperator, StmtExpr)

#undef STMT_RANGE
#undef EXPR
#undef STMT