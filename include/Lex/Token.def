#ifndef TOKEN
#define TOKEN(KIND, STR)
#endif

#ifndef KEYWORD
#define KEYWORD(KIND, STR) TOKEN(KIND, STR)
#endif

TOKEN(Plus, "+")
TOKEN(Minus, "-")
TOKEN(Star, "*")
TOKEN(Slash, "/")
TOKEN(Percent, "%")
TOKEN(Amp, "&")
TOKEN(Pipe, "|")
TOKEN(AmpAmp, "&&")
TOKEN(PipePipe, "||")
TOKEN(Caret, "^")
TOKEN(PlusEqual, "+=")
TOKEN(MinusEqual, "-=")
TOKEN(StarEqual, "*=")
TOKEN(SlashEqual, "/=")
TOKEN(PercentEqual, "%=")
TOKEN(AmpEqual, "&=")
TOKEN(PipeEqual, "|=")
TOKEN(CaretEqual, "^=")
TOKEN(PlusPlus, "++")
TOKEN(MinusMinus, "--")
TOKEN(Equal, "=")
TOKEN(EqualEqual, "==")
TOKEN(NotEqual, "!=")
TOKEN(Exclaim, "!")
TOKEN(Tilde, "~")
TOKEN(Less, "<")
TOKEN(LessEqual, "<=")
TOKEN(LessLess, "<<")
TOKEN(LessLessEqual, "<<=")
TOKEN(Greater, ">")
TOKEN(GreaterEqual, ">=")
TOKEN(GreaterGreater, ">>")
TOKEN(GreaterGreaterEqual, ">>=")
TOKEN(Semicolon, ";")
TOKEN(Colon, ":")
TOKEN(Question, "?")
TOKEN(LParen, "(")
TOKEN(RParen, ")")
TOKEN(LSquare, "[")
TOKEN(RSquare, "]")
TOKEN(LBrace, "{")
TOKEN(RBrace, "}")
TOKEN(Comma, ",")
TOKEN(Dot, ".")
TOKEN(Ellipsis, "...")
TOKEN(Arrow, "->")
TOKEN(Hash, "#")
TOKEN(HashHash, "##")
TOKEN(PPNum, "pp_number")
TOKEN(Num, "numeric_constant")
TOKEN(CharLiteral, "char_literal")
TOKEN(StrLiteral, "string_literal")
TOKEN(Ident, "identifier")

KEYWORD(Return, "return")
KEYWORD(If, "if")
KEYWORD(Else, "else")
KEYWORD(For, "for")
KEYWORD(Do, "do")
KEYWORD(While, "while")
KEYWORD(Switch, "switch")
KEYWORD(Case, "case")
KEYWORD(Default, "default")
KEYWORD(Break, "break")
KEYWORD(Continue, "continue")
KEYWORD(Goto, "goto")
KEYWORD(Asm, "asm")
KEYWORD(Inline, "inline")
KEYWORD(ThreadLocal, "_Thread_local")
KEYWORD(GnuUThread, "__thread")
KEYWORD(Void, "void")
KEYWORD(UnderlineBool, "_Bool")
KEYWORD(Char, "char")
KEYWORD(Short, "short")
KEYWORD(Int, "int")
KEYWORD(Long, "long")
KEYWORD(Float, "float")
KEYWORD(Double, "double")
KEYWORD(Signed, "signed")
KEYWORD(Unsigned, "unsigned")
KEYWORD(Sizeof, "sizeof")
KEYWORD(Alignof, "_Alignof")
KEYWORD(Alignas, "_Alignas")
KEYWORD(Typeof, "typeof")
KEYWORD(Generic, "_Generic")
KEYWORD(Struct, "struct")
KEYWORD(Union, "union")
KEYWORD(Enum, "enum")
KEYWORD(Typedef, "typedef")
KEYWORD(Static, "static")
KEYWORD(Extern, "extern")
KEYWORD(Const, "const")
KEYWORD(Volatile, "volatile")
KEYWORD(Auto, "auto")
KEYWORD(Register, "register")
KEYWORD(Restrict, "restrict")
KEYWORD(GnuURestrict, "__restrict")
KEYWORD(GnuURestrictU, "__restrict__")
KEYWORD(Noreturn, "_Noreturn")

#undef KEYWORD
#undef TOKEN