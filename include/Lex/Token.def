#ifndef TOKEN
#define TOKEN(KIND, STR)
#endif

#ifndef KEYWORD
#define KEYWORD(KIND, STR) TOKEN(KIND, STR)
#endif

TOKEN(Plus, "+")
TOKEN(Minus, "-")
TOKEN(Star, "*")
TOKEN(Slash, "/")
TOKEN(Equal, "=")
TOKEN(EqualEqual, "==")
TOKEN(NotEqual, "!=")
TOKEN(Less, "<")
TOKEN(LessEqual, "<=")
TOKEN(Greater, ">")
TOKEN(GreaterEqual, ">=")
TOKEN(Semicolon, ";")
TOKEN(LParen, "(")
TOKEN(RParen, ")")
TOKEN(LSquare, "[")
TOKEN(RSquare, "]")
TOKEN(LBrace, "{")
TOKEN(RBrace, "}")
TOKEN(Amp, "&")
TOKEN(Comma, ",")
TOKEN(Dot, ".")
TOKEN(Num, "numeric_constant")
TOKEN(Str, "string_literal")
TOKEN(Ident, "identifier")

KEYWORD(Return, "return")
KEYWORD(If, "if")
KEYWORD(Else, "else")
KEYWORD(For, "for")
KEYWORD(While, "while")
KEYWORD(Int, "int")
KEYWORD(Char, "char")
KEYWORD(Sizeof, "sizeof")
KEYWORD(Struct, "struct")

#undef KEYWORD
#undef TOKEN