#ifndef TOKEN
#define TOKEN(KIND, STR)
#endif

TOKEN(Plus, "+")
TOKEN(Minus, "-")
TOKEN(Star, "*")
TOKEN(Slash, "/")
TOKEN(Equal, "=")
TOKEN(EqualEqual, "==")
TOKEN(NotEqual, "!=")
TOKEN(Less, "<")
TOKEN(LessEqual, "<=")
TOKEN(Greater, ">")
TOKEN(GreaterEqual, ">=")
TOKEN(Semicolon, ";")
TOKEN(LParen, "(")
TOKEN(RParen, ")")
TOKEN(LSquare, "[")
TOKEN(RSquare, "]")
TOKEN(LBrace, "{")
TOKEN(RBRace, "}")
TOKEN(Amp, "&")
TOKEN(Comma, ",")
TOKEN(Num, "numeric_constant")
TOKEN(Ident, "identifier")
TOKEN(Return, "return")
TOKEN(If, "if")
TOKEN(Else, "else")
TOKEN(For, "for")
TOKEN(While, "while")
TOKEN(Int, "int")

#undef TOKEN