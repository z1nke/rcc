#ifndef TOKEN
#define TOKEN(KIND, STR)
#endif

#ifndef KEYWORD
#define KEYWORD(KIND, STR) TOKEN(KIND, STR)
#endif

TOKEN(Plus, "+")
TOKEN(Minus, "-")
TOKEN(Star, "*")
TOKEN(Slash, "/")
TOKEN(Percent, "%")
TOKEN(Amp, "&")
TOKEN(Pipe, "|")
TOKEN(AmpAmp, "&&")
TOKEN(PipePipe, "||")
TOKEN(Caret, "^")
TOKEN(PlusEqual, "+=")
TOKEN(MinusEqual, "-=")
TOKEN(StarEqual, "*=")
TOKEN(SlashEqual, "/=")
TOKEN(PercentEqual, "%=")
TOKEN(AmpEqual, "&=")
TOKEN(PipeEqual, "|=")
TOKEN(CaretEqual, "^=")
TOKEN(PlusPlus, "++")
TOKEN(MinusMinus, "--")
TOKEN(Equal, "=")
TOKEN(EqualEqual, "==")
TOKEN(NotEqual, "!=")
TOKEN(Exclaim, "!")
TOKEN(Tilde, "~")
TOKEN(Less, "<")
TOKEN(LessEqual, "<=")
TOKEN(Greater, ">")
TOKEN(GreaterEqual, ">=")
TOKEN(Semicolon, ";")
TOKEN(LParen, "(")
TOKEN(RParen, ")")
TOKEN(LSquare, "[")
TOKEN(RSquare, "]")
TOKEN(LBrace, "{")
TOKEN(RBrace, "}")
TOKEN(Comma, ",")
TOKEN(Dot, ".")
TOKEN(Arrow, "->")
TOKEN(Num, "numeric_constant")
TOKEN(CharLiteral, "char_literal")
TOKEN(StrLiteral, "string_literal")
TOKEN(Ident, "identifier")

KEYWORD(Return, "return")
KEYWORD(If, "if")
KEYWORD(Else, "else")
KEYWORD(For, "for")
KEYWORD(While, "while")
KEYWORD(Void, "void")
KEYWORD(UnderlineBool, "_Bool")
KEYWORD(Char, "char")
KEYWORD(Short, "short")
KEYWORD(Int, "int")
KEYWORD(Long, "long")
KEYWORD(Sizeof, "sizeof")
KEYWORD(Struct, "struct")
KEYWORD(Union, "union")
KEYWORD(Enum, "enum")
KEYWORD(Typedef, "typedef")
KEYWORD(Static, "static")

#undef KEYWORD
#undef TOKEN