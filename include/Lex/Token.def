#ifndef TOKEN
#define TOKEN(KIND, STR)
#endif

#ifndef KEYWORD
#define KEYWORD(KIND, STR) TOKEN(KIND, STR)
#endif

TOKEN(Plus, "+")
TOKEN(Minus, "-")
TOKEN(Star, "*")
TOKEN(Slash, "/")
TOKEN(Percent, "%")
TOKEN(Amp, "&")
TOKEN(Pipe, "|")
TOKEN(AmpAmp, "&&")
TOKEN(PipePipe, "||")
TOKEN(Caret, "^")
TOKEN(PlusEqual, "+=")
TOKEN(MinusEqual, "-=")
TOKEN(StarEqual, "*=")
TOKEN(SlashEqual, "/=")
TOKEN(PercentEqual, "%=")
TOKEN(AmpEqual, "&=")
TOKEN(PipeEqual, "|=")
TOKEN(CaretEqual, "^=")
TOKEN(PlusPlus, "++")
TOKEN(MinusMinus, "--")
TOKEN(Equal, "=")
TOKEN(EqualEqual, "==")
TOKEN(NotEqual, "!=")
TOKEN(Exclaim, "!")
TOKEN(Tilde, "~")
TOKEN(Less, "<")
TOKEN(LessEqual, "<=")
TOKEN(LessLess, "<<")
TOKEN(LessLessEqual, "<<=")
TOKEN(Greater, ">")
TOKEN(GreaterEqual, ">=")
TOKEN(GreaterGreater, ">>")
TOKEN(GreaterGreaterEqual, ">>=")
TOKEN(Semicolon, ";")
TOKEN(Colon, ":")
TOKEN(Question, "?")
TOKEN(LParen, "(")
TOKEN(RParen, ")")
TOKEN(LSquare, "[")
TOKEN(RSquare, "]")
TOKEN(LBrace, "{")
TOKEN(RBrace, "}")
TOKEN(Comma, ",")
TOKEN(Dot, ".")
TOKEN(Ellipsis, "...")
TOKEN(Arrow, "->")
TOKEN(Num, "numeric_constant")
TOKEN(CharLiteral, "char_literal")
TOKEN(StrLiteral, "string_literal")
TOKEN(Ident, "identifier")

KEYWORD(Return, "return")
KEYWORD(If, "if")
KEYWORD(Else, "else")
KEYWORD(For, "for")
KEYWORD(Do, "do")
KEYWORD(While, "while")
KEYWORD(Switch, "switch")
KEYWORD(Case, "case")
KEYWORD(Default, "default")
KEYWORD(Break, "break")
KEYWORD(Continue, "continue")
KEYWORD(Goto, "goto")
KEYWORD(Void, "void")
KEYWORD(UnderlineBool, "_Bool")
KEYWORD(Char, "char")
KEYWORD(Short, "short")
KEYWORD(Int, "int")
KEYWORD(Long, "long")
KEYWORD(Signed, "signed")
KEYWORD(Sizeof, "sizeof")
KEYWORD(Alignof, "_Alignof")
KEYWORD(Alignas, "_Alignas")
KEYWORD(Struct, "struct")
KEYWORD(Union, "union")
KEYWORD(Enum, "enum")
KEYWORD(Typedef, "typedef")
KEYWORD(Static, "static")
KEYWORD(Extern, "extern")

#undef KEYWORD
#undef TOKEN